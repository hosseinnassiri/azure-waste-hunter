// waste-hunter 26 · Idle Redis caches: Azure Cache for Redis and Azure Managed Redis (CANDIDATES, confirmed by metrics)
// A cache bills every hour it exists. The runner flags one that had no connected clients at any point
// in 30 days. Azure Managed Redis (microsoft.cache/redisenterprise, SKUs like Balanced_B5) bills per
// instance, two with high availability on; legacy Enterprise and Enterprise Flash bill per capacity
// unit. `units` is that multiplier (shards for clustered Premium caches).
// (`shards` is a reserved word in Resource Graph KQL, so the column is shardCount/units.)
// READ-ONLY. Run:  az graph query -q @26-idle-redis-caches.kql --first 1000
resources
| where type in~ ('microsoft.cache/redis', 'microsoft.cache/redisenterprise')
| where tostring(properties.provisioningState) =~ 'Succeeded'
| extend managed = type =~ 'microsoft.cache/redisenterprise',
         skuName = tostring(sku.name)
| extend tierName = iff(managed, tostring(split(skuName, '_')[0]), tostring(properties.sku.name)),
         size = iff(managed, tostring(split(skuName, '_')[1]), strcat(tostring(properties.sku.family), tostring(properties.sku.capacity))),
         shardCount = iff(toint(properties.shardCount) > 0, toint(properties.shardCount), 1),
         haOff = tostring(properties.highAvailability) =~ 'Disabled',
         capacityUnits = coalesce(toint(sku.capacity), 2)
| extend units = case(not(managed), shardCount, skuName startswith 'Enterprise', capacityUnits, haOff, 1, 2)
| extend owner = coalesce(tostring(tags['owner']), tostring(tags['Owner']), tostring(tags['OWNER']), tostring(tags['createdBy']), tostring(tags['CreatedBy'])),
         app   = coalesce(tostring(tags['app']), tostring(tags['App']), tostring(tags['application']), tostring(tags['Application'])),
         env   = coalesce(tostring(tags['env']), tostring(tags['Env']), tostring(tags['environment']), tostring(tags['Environment'])),
         ignored = tostring(tags) contains '"waste-hunter:ignore":"true"'
| project wasteType = 'idle-redis-cache', id, name, type, tenantId, subscriptionId, resourceGroup, location,
          owner, app, env, createdTime = '', ageDays = int(null), idleDays = int(null), idleSource = 'pending (metrics)',
          sku = size, tier = tierName, sizeGb = units, os = '', extra = tostring(properties.redisVersion),
          confidence = 'pending', reason = '', ignored,
          checkInputs = pack('units', units, 'tier', tierName, 'managed', managed)
