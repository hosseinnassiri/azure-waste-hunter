// waste-hunter 19 · Empty resource groups
// Resource groups cost nothing. Empty ones are clutter, and they hide what's really in use.
// Skipped: managed resource groups (managedBy set, which their owning service deletes) and Azure
// Backup restore-point groups. A few resource types aren't indexed by Resource Graph, so a group
// that looks empty might not be. That's why these are medium confidence.
// READ-ONLY. Run:  az graph query -q @19-empty-resource-groups.kql --first 1000
resourcecontainers
| where type =~ 'microsoft.resources/subscriptions/resourcegroups'
| where isempty(tostring(managedBy)) and isempty(tostring(properties.managedBy))
| where name !startswith 'AzureBackupRG_'
| extend rgKey = tolower(name)
| join kind=leftouter (
    resources
    | summarize resourceCount = count() by subscriptionId, rgKey = tolower(resourceGroup)
  ) on subscriptionId, rgKey
| where coalesce(resourceCount, 0) == 0
| extend owner = coalesce(tostring(tags['owner']), tostring(tags['Owner']), tostring(tags['OWNER']), tostring(tags['createdBy']), tostring(tags['CreatedBy'])),
         app   = coalesce(tostring(tags['app']), tostring(tags['App']), tostring(tags['application']), tostring(tags['Application'])),
         env   = coalesce(tostring(tags['env']), tostring(tags['Env']), tostring(tags['environment']), tostring(tags['Environment'])),
         ignored = tostring(tags) contains '"waste-hunter:ignore":"true"'
| project wasteType = 'empty-resource-group', id, name, type, tenantId, subscriptionId, resourceGroup = name, location,
          owner, app, env, createdTime = '', ageDays = int(null), idleDays = int(null), idleSource = 'unknown (not exposed by Resource Graph)',
          sku = '', tier = '', sizeGb = int(null), os = '', extra = '',
          confidence = 'medium', reason = 'Resource group contains no resources indexed by Resource Graph', ignored
