// waste-hunter 31 · Public IP prefixes with no addresses in use
// A prefix bills every address in it every hour (a /28 is 16 addresses), whether or not any public IP,
// NAT gateway or load balancer uses it. IPv6 prefixes are skipped. A prefix may be kept on purpose so
// its addresses stay on partner allowlists, so these are medium confidence.
// READ-ONLY. Run:  az graph query -q @31-unused-public-ip-prefixes.kql --first 1000
resources
| where type =~ 'microsoft.network/publicipprefixes'
| where tostring(properties.publicIPAddressVersion) !~ 'IPv6'
| extend used = coalesce(array_length(properties.publicIPAddresses), 0),
         nat = isnotempty(tostring(properties.natGateway.id)),
         lbfe = isnotempty(tostring(properties.loadBalancerFrontendIpConfiguration.id)),
         prefixLength = toint(properties.prefixLength),
         ipPrefix = tostring(properties.ipPrefix)
| where used == 0 and not(nat) and not(lbfe)
| extend ips = toint(pow(2, 32 - prefixLength))
| extend owner = coalesce(tostring(tags['owner']), tostring(tags['Owner']), tostring(tags['OWNER']), tostring(tags['createdBy']), tostring(tags['CreatedBy'])),
         app   = coalesce(tostring(tags['app']), tostring(tags['App']), tostring(tags['application']), tostring(tags['Application'])),
         env   = coalesce(tostring(tags['env']), tostring(tags['Env']), tostring(tags['environment']), tostring(tags['Environment'])),
         ignored = tostring(tags) contains '"waste-hunter:ignore":"true"'
| project wasteType = 'unused-public-ip-prefix', id, name, type, tenantId, subscriptionId, resourceGroup, location,
          owner, app, env, createdTime = '', ageDays = int(null), idleDays = int(null), idleSource = 'unknown (not exposed by Resource Graph)',
          sku = tostring(sku.tier), tier = strcat('/', tostring(prefixLength)), sizeGb = ips, os = '', extra = ipPrefix,
          confidence = 'medium',
          reason = strcat('Prefix ', ipPrefix, ' (', tostring(ips), ' addresses) has no public IP, NAT gateway or load balancer using it, but every address bills hourly'),
          ignored
