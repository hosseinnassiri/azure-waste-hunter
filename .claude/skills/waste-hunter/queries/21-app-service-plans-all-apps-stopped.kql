// waste-hunter 21 · Paid App Service plans whose apps are all stopped
// A plan bills per instance whether its apps run or not. Stopping an app stops nothing on the bill.
// Query 04 covers plans with no apps; this one covers plans whose every app AND deployment slot is
// Stopped. Free, Shared and Consumption plans cost nothing, so they're low priority.
// READ-ONLY. Run:  az graph query -q @21-app-service-plans-all-apps-stopped.kql --first 1000
resources
| where type =~ 'microsoft.web/serverfarms'
| extend planId = tolower(id)
| join kind=inner (
    resources
    | where type in~ ('microsoft.web/sites', 'microsoft.web/sites/slots')
    | summarize apps = countif(type =~ 'microsoft.web/sites'), slots = countif(type =~ 'microsoft.web/sites/slots'),
                running = countif(tostring(properties.state) !~ 'Stopped'),
                appNames = make_list_if(name, type =~ 'microsoft.web/sites', 5)
             by planId = tolower(tostring(properties.serverFarmId))
  ) on planId
| where apps > 0 and running == 0
| extend skuName = tostring(sku.name), skuTier = tostring(sku.tier), workers = toint(sku.capacity)
| extend isFree = skuTier in~ ('Free', 'Shared', 'Dynamic', 'FlexConsumption') or skuName in~ ('F1', 'D1', 'Y1', 'FC1')
| extend owner = coalesce(tostring(tags['owner']), tostring(tags['Owner']), tostring(tags['OWNER']), tostring(tags['createdBy']), tostring(tags['CreatedBy'])),
         app   = coalesce(tostring(tags['app']), tostring(tags['App']), tostring(tags['application']), tostring(tags['Application'])),
         env   = coalesce(tostring(tags['env']), tostring(tags['Env']), tostring(tags['environment']), tostring(tags['Environment'])),
         ignored = tostring(tags) contains '"waste-hunter:ignore":"true"'
| extend confidence = iff(isFree, 'low', 'high'),
         reason = strcat('All ', apps, ' app(s)', iff(slots > 0, strcat(' and ', slots, ' slot(s)'), ''), ' on this plan are stopped (',
                         strcat_array(appNames, ', '), iff(apps > 5, ', ...', ''), '), but the plan bills per instance (', skuTier, ' ', skuName, ' x', coalesce(workers, 1), ')',
                         iff(isFree, '; free/consumption tier, no charge', ''))
| project wasteType = 'stopped-app-service-plan', id, name, type, tenantId, subscriptionId, resourceGroup, location,
          owner, app, env, createdTime = '', ageDays = int(null), idleDays = int(null), idleSource = 'unknown (not exposed by Resource Graph)',
          sku = skuName, tier = skuTier, sizeGb = coalesce(workers, 1),
          os = iff(tobool(properties.reserved), 'Linux', 'Windows'), extra = tostring(apps),
          confidence, reason, ignored
