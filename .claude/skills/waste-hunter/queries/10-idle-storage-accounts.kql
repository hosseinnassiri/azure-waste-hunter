// waste-hunter 10 · Storage accounts: idle, or Hot-tier blobs nobody reads (CANDIDATES)
// Every storage account is a candidate. The runner confirms with metrics:
//   - idle: 0 transactions on the account (all services) in 30 days; priced by used capacity
//   - Hot blobs unread: 100 GiB or more of blob data on the Hot tier with 0 GetBlob reads in 30 days;
//     saving = capacity x (Hot - Cool)
// A storage account can be the volume behind a Container App (Azure Files), so Container Apps that
// mount Azure Files in the same subscription are listed in checkInputs and lower the confidence.
// "Quiet" must never read as "safe to delete" for an app's data store. Resource Graph doesn't
// expose which account a Container Apps environment mounts.
// READ-ONLY. Run:  az graph query -q @10-idle-storage-accounts.kql --first 1000
resources
| where type =~ 'microsoft.storage/storageaccounts'
| join kind=leftouter (
    resources
    | where type =~ 'microsoft.app/containerapps'
    | where tostring(properties.template.volumes) contains 'AzureFile'
    | summarize fileMountApps = make_list(pack('rg', tolower(resourceGroup), 'name', name)) by subscriptionId
  ) on subscriptionId
| extend createdTime = todatetime(properties.creationTime)
| extend ageDays = toint((now() - createdTime) / 1d)
| extend owner = coalesce(tostring(tags['owner']), tostring(tags['Owner']), tostring(tags['OWNER']), tostring(tags['createdBy']), tostring(tags['CreatedBy'])),
         app   = coalesce(tostring(tags['app']), tostring(tags['App']), tostring(tags['application']), tostring(tags['Application'])),
         env   = coalesce(tostring(tags['env']), tostring(tags['Env']), tostring(tags['environment']), tostring(tags['Environment'])),
         ignored = tostring(tags) contains '"waste-hunter:ignore":"true"'
| project wasteType = 'idle-storage-account', id, name, type, tenantId, subscriptionId, resourceGroup, location,
          owner, app, env, createdTime, ageDays, idleDays = int(null), idleSource = 'pending (metrics)',
          sku = tostring(sku.name), tier = tostring(properties.accessTier), sizeGb = int(null), os = '', extra = kind,
          confidence = 'pending', reason = '', ignored,
          checkInputs = pack('accessTier', tostring(properties.accessTier), 'kind', kind, 'isHns', tobool(properties.isHnsEnabled),
                             'fileMountApps', fileMountApps)
